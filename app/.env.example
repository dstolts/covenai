# CovenAI Environment Variables
# Copy to .env.local and fill in values

# Auth (NextAuth.js / Auth.js)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Database (Azure SQL)
DATABASE_URL=

# Email (Resend)
RESEND_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://covenai.co
